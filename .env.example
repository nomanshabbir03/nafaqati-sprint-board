# Copy to .env.local for local work. On Vercel, add the same names under Project Settings > Environment Variables.

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Publishable key (sb_publishable_...), or the older "anon" key under the name SUPABASE_ANON_KEY. Safe to expose: row-level security makes it read-only.
SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...), or the older "service_role" key under the name SUPABASE_SERVICE_ROLE_KEY. SECRET: server only, never commit it or paste it into chat.
SUPABASE_SECRET_KEY=

# Anyone with this key can add, move and delete cards. Choose a long random string.
EDIT_KEY=
